# =============================================================================
# Ayurvedic IPR & Regulatory AI Assistant — Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://ayurveda:ayurveda_secret@localhost:5432/ayurveda_ipr
DATABASE_URL_SYNC=postgresql://ayurveda:ayurveda_secret@localhost:5432/ayurveda_ipr

# --- Qdrant Vector Database ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ayurveda_legal

# --- Redis ---
REDIS_URL=redis://:ayurveda_redis_secret@localhost:6379/0

# --- LLM Configuration ---
# Providers: ollama, openai, lmstudio
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# --- Embedding Configuration ---
# Providers: local, openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# --- Reranker Configuration ---
# Providers: local, cohere
RERANKER_PROVIDER=local
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
COHERE_API_KEY=

# --- Authentication ---
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Application & Network Security ---
APP_NAME=Ayurvedic IPR & Regulatory AI Assistant
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# --- Multilingual (Optional) ---
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# --- Rate Limiting & DoS Protection ---
RATE_LIMIT_PER_MINUTE=120

# --- Crawler ---
CRAWLER_USER_AGENT=AyurvedaIPR-Bot/1.0
CRAWLER_MAX_CONCURRENT=3
CRAWLER_RATE_LIMIT_SECONDS=1

# --- Admin Credentials (Bootstrap) ---
ADMIN_EMAIL=admin@ayurveda-ipr.gov.in
ADMIN_PASSWORD=ChangeThisAdminPasswordInProduction!
ADMIN_NAME=Ayurvedic IPR System Administrator
